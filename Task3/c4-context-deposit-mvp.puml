@startuml c4-context-deposit-mvp
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Открытие депозита (MVP) - диаграмма контекста

Person(client, "Клиент", "Новый или существующий клиент банка")
Person(cc_operator, "Оператор кол-центра", "Звонит по заявкам с сайта")
Person(back_office, "Менеджер бэк-офиса депозитов", "Ведёт ставки, обрабатывает заявки")
Person(branch, "Сотрудник отделения", "Идентифицирует клиента, открывает депозит")

System(site, "Сайт", "PHP, React.js. Список депозитов, заявка от нового клиента")
System(ib, "Интернет-банк", "Список депозитов, персональные ставки, заявка на депозит, СМС-подтверждение")
System(cc, "Система кол-центра", "Платформа подрядчика. Заявки с сайта")
System(abs, "АБС", "Ставки, обработка заявок, открытие депозитов")
System(kafka, "Kafka", "Обмен событиями между системами")
System_Ext(sms_gw, "СМС-шлюз", "Отправка СМС")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС клиенту")

Rel(client, site, "Смотрит депозиты, оставляет заявку", "HTTPS")
Rel(client, ib, "Смотрит ставки, подаёт заявку, вводит СМС-код", "HTTPS")
Rel(client, branch, "Приходит для идентификации и открытия депозита")

Rel(site, ib, "Получает список депозитов и ставки", "REST/HTTPS")
Rel(site, kafka, "Заявка с сайта", "Kafka")
Rel(kafka, cc, "Заявка с сайта", "Kafka")
Rel(ib, kafka, "Заявка на депозит / получает статусы и ставки", "Kafka")
Rel(abs, kafka, "Ставки, статусы заявок / получает заявки", "Kafka")
Rel(cc, abs, "Заявка и особые условия (текущая интеграция)")

Rel(cc_operator, cc, "Работает с заявкой, звонит клиенту")
Rel(back_office, abs, "Ведёт ставки, подтверждает ставку, открывает депозит")
Rel(branch, abs, "Находит заявку, открывает депозит")

Rel(ib, sms_gw, "СМС-коды и уведомления")
Rel(sms_gw, telecom, "Отправка СМС")
Rel(telecom, client, "СМС")

@enduml
